# Copy to .env (git-ignored) and adjust. Never commit real secrets.
# Values below are local-development placeholders only.
ENV=dev
POSTGRES_DB=esims
POSTGRES_USER=esims
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://esims:change-me@db:5432/esims
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Password for the sample users created by the seed script (admin, manager, staff, cashier).
SEED_USER_PASSWORD=123
# Plain HTTP in local development, so cookies cannot be Secure. Always true in production.
COOKIE_SECURE=false
# Login lockout and session timeouts (SRS A-12). These are the defaults.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Product image uploads are stored on the product-images Docker volume.
PRODUCT_IMAGE_MAX_BYTES=5242880
VITE_PRODUCT_IMAGE_MAX_BYTES=5242880
# GST percentage applied to each discounted sale line.
GST_RATE=18
# Return eligibility window in days (SRS A-1).
RETURN_WINDOW_DAYS=30
# Store branding and optional GSTIN for invoice and receipt headers.
STORE_NAME=ESIMS Electronics
STORE_GSTIN=
# Mailpit web UI (catches password reset emails in development).
MAILPIT_PORT=8025
