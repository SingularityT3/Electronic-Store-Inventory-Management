# Copy to .env.prod (git-ignored) and fill in real values. Used by docker-compose.prod.yml.
# Domain name users will visit. A public name gets a Let's Encrypt certificate (ports 80 and 443
# must be reachable); "localhost" or an internal name gets a certificate from Caddy's own CA.
SITE_ADDRESS=esims.example.com
POSTGRES_DB=esims
POSTGRES_USER=esims
# Generate with: openssl rand -base64 32 (use URL-safe characters, it is embedded in DATABASE_URL)
POSTGRES_PASSWORD=
# For the bundled database: postgresql://<user>:<password>@db:5432/<db>
# For a managed database, use its connection string and add ?sslmode=require
DATABASE_URL=
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=
# Keep true in production: session cookies are sent over HTTPS only.
COOKIE_SECURE=true
# Login lockout and session timeouts (SRS A-12). These are the defaults.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Outgoing mail for password reset links. Without SMTP_HOST, self-service reset emails are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=ESIMS <no-reply@example.com>
# Uptime monitor (docs/monitoring.md): store hours, and where outage alerts go.
MONITOR_TIMEZONE=UTC
MONITOR_STORE_HOURS=09:00-21:00
# Weekdays the store is open, 0 = Monday.
MONITOR_STORE_DAYS=0,1,2,3,4,5,6
# Email (uses SMTP_* above) and/or a Slack/Discord-style webhook.
MONITOR_ALERT_TO=
MONITOR_WEBHOOK_URL=
# Daily backups (docs/backup-recovery.md). BACKUP_PATH is a directory on storage separate from the
# app server (a mounted NFS/SMB share or external disk); without it, backups stay on a Docker volume
# on the same host, which does not survive losing the server.
BACKUP_PATH=
BACKUP_TIME=02:00
# Every backup of the last 30 days, then the first of each month for 96 months (8 years, SRS A-2).
BACKUP_KEEP_DAILY_DAYS=30
BACKUP_KEEP_MONTHLY=96
# Return window in calendar days (SRS A-1).
# Return window in calendar days (SRS A-1).
RETURN_WINDOW_DAYS=30
# Store branding and optional GSTIN for invoice and receipt headers.
STORE_NAME=ESIMS Electronics
STORE_GSTIN=
RETENTION_YEARS=8
RETENTION_ARCHIVE_PATH=/retention-archive
