# Copy to .env.prod (git-ignored) and fill in real values. Used by docker-compose.prod.yml.
# Domain name users will visit. A public name gets a Let's Encrypt certificate (ports 80 and 443
# must be reachable); "localhost" or an internal name gets a certificate from Caddy's own CA.
SITE_ADDRESS=esims.example.com
POSTGRES_DB=esims
POSTGRES_USER=esims
# Generate with: openssl rand -base64 32 (use URL-safe characters, it is embedded in DATABASE_URL)
POSTGRES_PASSWORD=
# For the bundled database: postgresql://<user>:<password>@db:5432/<db>
# For a managed database, use its connection string and add ?sslmode=require
DATABASE_URL=
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=
# Keep true in production: session cookies are sent over HTTPS only.
COOKIE_SECURE=true
